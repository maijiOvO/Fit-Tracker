# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# ✅ 环境变量 - 敏感信息不应该被 git 追踪
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
# Claude Code：launch.json 是项目配置（dev server 怎么起），要提交；
# settings.local.json 按约定是本机覆盖（权限白名单、本地路径），不要。
.claude/settings.local.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ✅ 构建产物
*.zip
app.zip
android/*.apk
android/app/build/

# e2e artifacts
test-artifacts/

# 图标源图 assets/icon-source.jpg 要提交（build-icons.mjs 的唯一输入），
# 但 assets/icon.png 是它的产物，且与 android/icon.png 字节相同 ——
# 同一张 965KB 的图没必要在仓库里躺两份。
assets/icon.png

# 字体源文件（252MB 第三方 TTF，构建输入而非产物）
# 来源：fonts.google.com —— Noto Sans SC / Noto Serif SC（可变）、IBM Plex Mono、Ma Shan Zheng
# 开头的 / 是关键：裸 `fonts/` 会连 public/fonts/ 一起忽略掉，
# 而那里的子集 woff2 产物必须提交（新克隆没有源文件，构建脚本会跳过子集化）。
/fonts/

# 场地回填前的云端快照备份（含个人训练数据，不入库）
scripts/.gym-backup.json

# ✅ 安卓正式签名 —— 泄漏不可逆
# keystore 一旦进过 git 历史就等于作废：别人能签出冒充你的更新包，
# 而 git 历史里的文件删不干净（要 filter-repo 重写 + 强推 + 换密钥）。
# 反过来 keystore 自己丢了同样不可逆：包名 + 签名指纹绑定，
# 丢了就永远无法给已装用户发更新，只能换包名重来。
# ⇒ 本地备份到 git 以外的地方（密码管理器 / 加密网盘），两头都堵死。
*.keystore
*.jks
android/key.properties
android/app/*.keystore
android/app/*.jks

# 签名产物
android/app/release/
**/*-release.apk
**/*-release.aab
