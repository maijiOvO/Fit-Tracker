{
  "name": "fitlog-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:fonts && vite build",
    "build:release": "npm run build:fonts && vite build --mode release",
    "build:fonts": "node scripts/build-fonts.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-smoke.mjs",
    "validate": "npm run typecheck && npm run build",
    "android": "powershell -ExecutionPolicy Bypass -File scripts/deploy-android.ps1",
    "android:dev": "powershell -ExecutionPolicy Bypass -File scripts/deploy-android.ps1 -Dev",
    "android:reinstall": "powershell -ExecutionPolicy Bypass -File scripts/deploy-android.ps1 -SkipBuild",
    "check-remote": "node scripts/check-remote.mjs",
    "remote-detail": "node scripts/remote-detail.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "lucide-react": "^0.562.0",
    "pinyin-pro": "^3.29.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
